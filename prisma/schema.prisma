generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── NextAuth required models ───────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  googleId      String?   @unique
  email         String    @unique
  name          String?
  image         String?
  avatarUrl     String?
  emailVerified DateTime?
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  accounts      Account[]
  sessions      Session[]
  sellerProfile SellerProfile?
  inquiries     Inquiry[]
  orders        Order[]
  reports       Report[]
  wishlists     UserWishlist[]
  recentlyViewed RecentlyViewed[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ─────────────────────────────────────────────

model SellerProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  displayName       String
  description       String?
  contactPreference String?
  verificationState String    @default("PENDING")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@map("seller_profiles")
}

model Listing {
  id            String   @id @default(cuid())
  sellerId      String
  type          String
  title         String
  status        String   @default("DRAFT")
  canonicalData String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  inquiries Inquiry[]
  orders   Order[]

  @@map("listings")
}

model Inquiry {
  id                String    @id @default(cuid())
  userId            String
  listingId         String?
  type              String
  selectedPackageId String?
  status            String    @default("PENDING")
  message           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@map("inquiries")
}

model Order {
  id                String    @id @default(cuid())
  userId            String
  listingId         String?
  type              String
  selectedPackageId String?
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@map("orders")
}

model Report {
  id          String   @id @default(cuid())
  userId      String
  targetType  String
  targetId    String
  reason      String
  description String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model UserWishlist {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("user_wishlists")
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  listingId String
  type      String
  viewedAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("recently_viewed")
}
