# FF TRUST — environment variables
# Copy to .env.local for local development. Never commit real secrets.
#
# DATABASE_URL
#   PostgreSQL connection string (Neon, Supabase, or local PostgreSQL).
#   Required for auth, user accounts, and marketplace features.
#   Format: postgresql://user:password@host:port/dbname?sslmode=require
#
# AUTH_SECRET
#   NextAuth secret. Run: npx auth secret to generate.
#
# AUTH_GOOGLE_ID
#   Google OAuth Client ID.
#
# AUTH_GOOGLE_SECRET
#   Google OAuth Client Secret.
#
# NEXT_PUBLIC_SITE_URL
#   Canonical site URL used for OG images, canonical links, sitemap, robots.txt.
#   Set in Netlify for production. Leave UNSET for local dev (http://localhost:1111).

DATABASE_URL=postgresql://user:password@localhost:5432/fftrust
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:1111
